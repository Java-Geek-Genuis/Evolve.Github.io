<Page
    x:Class="PetWorldMobile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBrush}"
    Tapped="Page_Tapped">

  <Page.Resources>
    <Storyboard x:Name="IdlePetStoryboard">
      <DoubleAnimation Storyboard.TargetName="PetCharacter"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                       From="0.985" To="1.02" Duration="0:0:1.5"
                       AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="TailTransform"
                       Storyboard.TargetProperty="Rotation"
                       From="-5" To="7" Duration="0:0:1.2"
                       AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>

    <Storyboard x:Name="BlinkStoryboard">
      <DoubleAnimation Storyboard.TargetName="EyeL"
                       Storyboard.TargetProperty="ScaleY"
                       From="1" To="0.12" Duration="0:0:0.08"
                       AutoReverse="True"/>
      <DoubleAnimation Storyboard.TargetName="EyeR"
                       Storyboard.TargetProperty="ScaleY"
                       From="1" To="0.12" Duration="0:0:0.08"
                       AutoReverse="True"/>
    </Storyboard>

    <Storyboard x:Name="ActionBounceStoryboard">
      <DoubleAnimation Storyboard.TargetName="PetCharacter"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                       From="0" To="-22" Duration="0:0:0.18"
                       AutoReverse="True" RepeatBehavior="2x"/>
    </Storyboard>

    <Storyboard x:Name="PetReactionStoryboard">
      <DoubleAnimation Storyboard.TargetName="PetCharacter"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                       From="1" To="1.10" Duration="0:0:0.16"
                       AutoReverse="True"/>
      <DoubleAnimation Storyboard.TargetName="PetCharacter"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                       From="1" To="0.92" Duration="0:0:0.16"
                       AutoReverse="True"/>
    </Storyboard>

    <Storyboard x:Name="BubbleStoryboard">
      <DoubleAnimation Storyboard.TargetName="SpeechBubble"
                       Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.15"/>
      <DoubleAnimation Storyboard.TargetName="SpeechBubble"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                       From="0.75" To="1" Duration="0:0:0.15"/>
      <DoubleAnimation Storyboard.TargetName="SpeechBubble"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                       From="0.75" To="1" Duration="0:0:0.15"/>
    </Storyboard>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="12,10,12,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock x:Name="PetNameText"
                     Text="Blinky"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LevelText" Text="LEVEL 1" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock x:Name="MoodText" Text="CONTENT" FontSize="12" FontWeight="SemiBold"
                       Foreground="#AEBBD0"/>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="16"
                Padding="12,7"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock x:Name="CoinText" Text="40 COINS"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusMiniText" Text="HAPPY"
                       FontSize="11" Foreground="#AEBBD0"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Background="#1A2435"
              CornerRadius="12"
              Padding="8,6"
              Margin="0,6,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="HUNGER" FontSize="9" Foreground="#AEBBD0"/>
            <ProgressBar x:Name="HungerBar" Minimum="0" Maximum="100" Height="7" Margin="0,2,6,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock Text="ENERGY" FontSize="9" Foreground="#AEBBD0"/>
            <ProgressBar x:Name="EnergyBar" Minimum="0" Maximum="100" Height="7" Margin="3,2,3,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="HAPPINESS" FontSize="9" Foreground="#AEBBD0"/>
            <ProgressBar x:Name="HappinessBar" Minimum="0" Maximum="100" Height="7" Margin="6,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="10,0,10,8">
      <Border Background="{StaticResource RoomBrush}" CornerRadius="24">
        <Grid>
          <!-- window -->
          <Border Width="145" Height="95"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="22,22,0,0"
                  Background="#D9F3FF"
                  BorderBrush="#F6FBFF"
                  BorderThickness="7"
                  CornerRadius="12">
            <Grid>
              <Rectangle Fill="#B7E5F7" Margin="5"/>
              <Rectangle Fill="#8FC9E5" Height="3" VerticalAlignment="Center" Margin="5"/>
              <Rectangle Fill="#8FC9E5" Width="3" HorizontalAlignment="Center" Margin="5"/>
              <Ellipse Width="25" Height="25" Fill="#FFF4BA"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"/>
            </Grid>
          </Border>

          <!-- hanging light -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
            <Rectangle Width="3" Height="25" Fill="#4A566B"/>
            <Border Width="70" Height="38" Background="#F3D27C"
                    CornerRadius="28,28,10,10"
                    Opacity="0.95"/>
          </StackPanel>

          <!-- plant -->
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18">
            <Canvas Width="72" Height="82">
              <Ellipse Width="22" Height="44" Fill="#58B77E" Canvas.Left="8" Canvas.Top="8" RenderTransformOrigin="0.5,1">
                <Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="22" Height="44" Fill="#6DCF92" Canvas.Left="28" Canvas.Top="2" RenderTransformOrigin="0.5,1">
                <Ellipse.RenderTransform><RotateTransform Angle="8"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="22" Height="44" Fill="#489A6A" Canvas.Left="45" Canvas.Top="10" RenderTransformOrigin="0.5,1">
                <Ellipse.RenderTransform><RotateTransform Angle="25"/></Ellipse.RenderTransform>
              </Ellipse>
              <Border Width="44" Height="30" Background="#D18B5C"
                      CornerRadius="5"
                      Canvas.Left="14" Canvas.Top="48"/>
            </Canvas>
          </StackPanel>

          <!-- rug -->
          <Ellipse Width="250" Height="85"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,18"
                   Fill="#C18BE2"
                   Opacity="0.33"/>

          <!-- sofa -->
          <Border Width="175" Height="82"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="20,0,0,24"
                  Background="#B96873"
                  CornerRadius="20,20,10,10">
            <Grid>
              <Border Height="52" Background="#CF7A83" CornerRadius="18" Margin="8,5,8,25"/>
              <Border Width="25" Height="42" Background="#A95563" CornerRadius="11"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,8"/>
              <Border Width="25" Height="42" Background="#A95563" CornerRadius="11"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,8"/>
            </Grid>
          </Border>

          <!-- small table -->
          <Border Width="72" Height="55"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,115,20"
                  Background="#B57A53"
                  CornerRadius="9">
            <Grid>
              <Ellipse Width="48" Height="16" Fill="#E3A86F" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5"/>
              <Rectangle Width="8" Height="28" Fill="#8C5D41" HorizontalAlignment="Left" Margin="11,16,0,0"/>
              <Rectangle Width="8" Height="28" Fill="#8C5D41" HorizontalAlignment="Right" Margin="0,16,11,0"/>
            </Grid>
          </Border>

          <!-- pet shadow -->
          <Ellipse Width="175" Height="34"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,53"
                   Fill="#3A3154" Opacity="0.26"/>

          <!-- speech bubble -->
          <Border x:Name="SpeechBubble"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="84,74,0,0"
                  Background="#F8FBFF"
                  BorderBrush="#D5DFEA"
                  BorderThickness="1"
                  CornerRadius="18"
                  Padding="12,8"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <CompositeTransform ScaleX="0.75" ScaleY="0.75"/>
            </Border.RenderTransform>
            <TextBlock x:Name="SpeechText"
                       Text="Hi!"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#24314B"/>
          </Border>

          <!-- animated pet -->
          <Grid x:Name="PetCharacter"
                Width="210" Height="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,55,0,0"
                RenderTransformOrigin="0.5,0.6"
                Tapped="Pet_Tapped">
            <Grid.RenderTransform>
              <CompositeTransform/>
            </Grid.RenderTransform>

            <!-- tail behind body -->
            <Grid Width="78" Height="115"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="-20,0,-6,46"
                  RenderTransformOrigin="0.1,0.9">
              <Grid.RenderTransform>
                <CompositeTransform x:Name="TailTransform"/>
              </Grid.RenderTransform>
              <Ellipse Width="56" Height="95"
                       Fill="#D78F72"
                       Stroke="#A86152"
                       StrokeThickness="5"
                       RenderTransformOrigin="0.25,0.85">
                <Ellipse.RenderTransform><RotateTransform Angle="-25"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>

            <!-- body -->
            <Ellipse Width="145" Height="145"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,28"
                     Fill="{StaticResource PetBodyBrush}"
                     Stroke="#A55F51"
                     StrokeThickness="5"/>

            <!-- belly -->
            <Ellipse Width="94" Height="79"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,42"
                     Fill="#F7D2B8"/>

            <!-- left arm -->
            <Border Width="30" Height="72"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="33,0,0,58"
                    Background="{StaticResource PetBodyBrush}"
                    CornerRadius="15"
                    RenderTransformOrigin="0.5,0.1">
              <Border.RenderTransform><RotateTransform Angle="17"/></Border.RenderTransform>
            </Border>

            <!-- right arm -->
            <Border Width="30" Height="72"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,33,58"
                    Background="{StaticResource PetBodyBrush}"
                    CornerRadius="15"
                    RenderTransformOrigin="0.5,0.1">
              <Border.RenderTransform><RotateTransform Angle="-17"/></Border.RenderTransform>
            </Border>

            <!-- feet -->
            <Ellipse Width="47" Height="34"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="39,0,0,15"
                     Fill="#A96155"/>
            <Ellipse Width="47" Height="34"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,39,15"
                     Fill="#A96155"/>

            <!-- head -->
            <Grid Width="175" Height="165"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
              <Polygon Points="18,54 28,8 70,38"
                       Fill="{StaticResource PetBodyBrush}"
                       Stroke="#A55F51" StrokeThickness="5"/>
              <Polygon Points="157,54 147,8 105,38"
                       Fill="{StaticResource PetBodyBrush}"
                       Stroke="#A55F51" StrokeThickness="5"/>
              <Polygon Points="30,45 31,25 55,40"
                       Fill="#F4B9AA"/>
              <Polygon Points="145,45 144,25 120,40"
                       Fill="#F4B9AA"/>
              <Ellipse Width="153" Height="125"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource PetBodyBrush}"
                       Stroke="#A55F51"
                       StrokeThickness="5"/>

              <!-- eyes -->
              <Ellipse x:Name="EyeL" Width="28" Height="38"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="41,9,0,0" Fill="#2B2433">
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleY="1"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse x:Name="EyeR" Width="28" Height="38"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,9,41,0" Fill="#2B2433">
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleY="1"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="9" Height="11" Fill="White"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="47,0,0,13"/>
              <Ellipse Width="9" Height="11" Fill="White"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,47,13"/>

              <!-- muzzle -->
              <Ellipse Width="70" Height="43"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,16"
                       Fill="#F8E0CF"/>
              <Ellipse Width="13" Height="9"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,48"
                       Fill="#B75E67"/>
              <Path Data="M87,111 Q87,126 72,129 M87,111 Q87,126 102,129"
                    Stroke="#56363B"
                    StrokeThickness="4"
                    Fill="Transparent"/>
            </Grid>
          </Grid>

          <!-- floating interaction dots -->
          <Ellipse x:Name="Spark1" Width="8" Height="8" Fill="#FFF4BA"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="-92,38,0,0" Opacity="0.8"/>
          <Ellipse x:Name="Spark2" Width="6" Height="6" Fill="#FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="105,-18,0,0" Opacity="0.75"/>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2">
      <Grid Padding="8,0,8,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Click="Feed_Click" Background="#E98C72">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="FOOD" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock x:Name="FoodHint" Text="+" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Click="Play_Click" Background="#6E9FE8">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="PLAY" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="FUN" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Click="Sleep_Click" Background="#806CCB">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="REST" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="SLEEP" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="3" Click="Explore_Click" Background="#5FB88B">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="GO" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="EXPLORE" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/>
          </StackPanel>
        </Button>
      </Grid>

      <Grid Padding="8,0,8,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Click="Adventure_Click" Background="{StaticResource PanelBrush}">
          <TextBlock Text="ADVENTURE" FontSize="11" FontWeight="SemiBold"/>
        </Button>
        <Button Grid.Column="1" Click="Link_Click" Background="{StaticResource PanelBrush}">
          <TextBlock Text="FRIENDS" FontSize="11" FontWeight="SemiBold"/>
        </Button>
        <Button Grid.Column="2" Click="Stats_Click" Background="{StaticResource PanelBrush}">
          <TextBlock Text="PROFILE" FontSize="11" FontWeight="SemiBold"/>
        </Button>
        <Button Grid.Column="3" Click="Save_Click" Background="{StaticResource PanelBrush}">
          <TextBlock Text="SAVE" FontSize="11" FontWeight="SemiBold"/>
        </Button>
      </Grid>

      <Border Background="#121A28" Padding="10,5,10,8">
        <TextBlock x:Name="MessageText"
                   Text="Tap your pet. It reacts!"
                   FontSize="13"
                   TextAlignment="Center"
                   Foreground="#B9C7DC"/>
      </Border>
    </StackPanel>
  </Grid>
</Page>