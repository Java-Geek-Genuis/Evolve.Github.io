<Page
    x:Class="PetWorldMobile.AdventurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="10,10,10,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock Text="ADVENTURE"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="TitleText"
                   Text="Meadow Trail"
                   FontSize="27"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>
      </StackPanel>

      <Button Grid.Column="1"
              Content="BACK"
              Click="Back_Click"
              VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="1"
            Background="#17243A"
            CornerRadius="20"
            Margin="10,0,10,6"
            Padding="7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,3,4,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="#263A57" CornerRadius="10" Padding="8,5" Margin="2">
            <StackPanel>
              <TextBlock Text="ENERGY" FontSize="9" Foreground="#9FB1C8"/>
              <TextBlock x:Name="EnergyText" Text="88" FontSize="17" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="#263A57" CornerRadius="10" Padding="8,5" Margin="2">
            <StackPanel>
              <TextBlock Text="HAPPY" FontSize="9" Foreground="#9FB1C8"/>
              <TextBlock x:Name="HappinessText" Text="80" FontSize="17" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="#263A57" CornerRadius="10" Padding="8,5" Margin="2">
            <StackPanel>
              <TextBlock Text="COINS" FontSize="9" Foreground="#9FB1C8"/>
              <TextBlock x:Name="CoinsText" Text="40" FontSize="17" FontWeight="Bold"
                         Foreground="#FFD86B"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Background="#102039" CornerRadius="15" Padding="6">
          <Grid x:Name="MapGrid"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="4,8,4,2">
          <TextBlock x:Name="InfoText"
                     Text="Blinky • Forest • 0,0"
                     FontSize="12"
                     Foreground="#B9C7DC"
                     Margin="2,0,2,4"/>
          <Border Background="#223451" CornerRadius="10" Padding="9,7">
            <TextBlock x:Name="MessageText"
                       Text="Your pet is ready for an adventure."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Margin="10,2,10,3"
            Background="#1A263C"
            CornerRadius="16"
            Padding="7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="1" Content="▲" Click="Up_Click" FontSize="20"/>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="◀" Click="Left_Click" FontSize="20"/>
          <Button Grid.Column="1" Content="✦" Click="Act_Click" FontSize="20" Background="#4C78C7"/>
          <Button Grid.Column="2" Content="▶" Click="Right_Click" FontSize="20"/>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="▼" Click="Down_Click" FontSize="20"/>
          <Button Grid.Column="1" Content="REST" Click="Rest_Click" Background="#6D5BB8"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Background="#111A2A"
            Padding="10,7"
            HorizontalAlignment="Stretch">
      <TextBlock Text="Move • discover • collect • grow"
                 FontSize="11"
                 TextAlignment="Center"
                 Foreground="#8EA0B8"/>
    </Border>
  </Grid>
</Page>