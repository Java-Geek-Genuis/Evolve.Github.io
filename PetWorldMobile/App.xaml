<Application
    x:Class="PetWorldMobile.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#182031"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#24314B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#53C797"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9"/>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Background" Value="#30425F"/>
      <Setter Property="Foreground" Value="#F1F5F9"/>
    </Style>
  </Application.Resources>
</Application>
